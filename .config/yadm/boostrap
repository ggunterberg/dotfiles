#!/usr/bin/env bash
set -euo pipefail

sddm_theme() {
  local font_source="$HOME/.config/sddm/fonts"
  local font_dest="/usr/local/share/fonts/gunterberg-sddm-themes"

  local theme_source="$HOME/.config/sddm/themes/."
  local theme_dest="/usr/share/sddm/themes/gunterberg-ssdm-themes"

  local config_source="$HOME/.config/sddm/config"
  local config_dest="/etc/sddm.conf.d"

  if [[ ! -d "$theme_source" ]]; then
    echo "sddm theme directory not found: $theme_source"
    return 1
  fi

  if [[ ! -d "$font_source" ]]; then
    echo "font directory not found: $font_source"
    return 1
  fi

  if [[ ! -d "$config_source" ]]; then
    echo "sddm configuration directory not found: $config_source"
    return 1
  fi

  echo "installing needed gunterberg-sddm-theme packages"
  sudo pacman --needed --noconfirm -S \
      sddm qt6-svg qt6-virtualkeyboard qt6-multimedia-ffmpeg

  echo "installing gunterberg-sddm-theme fonts"
  sudo rm -rf "$font_dest"
  sudo mkdir -p "$font_dest"
  sudo cp -vfr "$font_source/." "$font_dest/"

  echo "refreshing font cache"
  sudo fc-cache -f

  echo "installing sddm theme at $theme_dest"
  sudo rm -rf "$theme_dest"
  sudo mkdir -p "$theme_dest"
  sudo cp -vfr "$theme_source/." "$theme_dest/"

  echo "installing sddm configuration at $config_dest"
  sudo mkdir -p "$config_dest"
  sudo cp -vfr "$config_source/." "$config_dest/"
}

sddm_theme